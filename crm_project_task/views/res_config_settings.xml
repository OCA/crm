<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.crm.project.task</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="crm" position="inside">
                <block title="Projects" name="crm_project_task_block">
                    <setting
                        title="Default project"
                        string="Default project"
                        id="crm_project_task_setting"
                    >
                        <div class="text-muted">
                            <span
                            >By default this project will be selected to create task from lead / opportunity</span>
                            <span
                                class="fa fa-lg fa-building-o ms-2"
                                title="Values set here are company-specific."
                            />
                        </div>
                        <field name="crm_default_project_id" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
