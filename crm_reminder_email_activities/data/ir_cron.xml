<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="crm_email_reminder_activities_cron" model="ir.cron">
        <field name="name">Reminder CRM planned activities</field>
        <field name="model_id" ref="model_res_users" />
        <field name="active" eval="True" />
        <field name="doall" eval="False" />
        <field name="state">code</field>
        <field name="code">model.cron_send_crm_reminder_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field
            name="nextcall"
            eval="(DateTime.today() + relativedelta(weekday=6)).strftime('%Y-%m-%d')"
        />
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root" />
    </record>
</odoo>
