#. module: crm_reminder_email_activities
#: model:mail.template,body_html:crm_reminder_email_activities.email_template_crm_reminder_activities
msgid ""
"<div>\n"
"                <span style=\"font-size: 0.75rem;\">Reminder CRM planned activities\n"
"            </span>\n"
"                <br/>\n"
"                <span style=\"font-size: 1.3rem; font-weight: bold;margin-top: 14px;\">\n"
"                    <t t-out=\"object.name or ''\">User</t>\n"
"                </span>\n"
"                <div style=\"font-size: 0.9rem\">\n"
"                    <p>Dear <t t-out=\"object.name or ''\">User</t>,\n"
"                </p>\n"
"                    <p>\n"
"                Below are your active CRM app tasks due in the next 7 days:\n"
"                </p>\n"
"                    <ul>\n"
"                        <t t-set=\"activities\" t-value=\"ctx.get('activities', '')\"/>\n"
"                        <t t-foreach=\"activities\" t-as=\"activity\">\n"
"                            <li>\n"
"                                <t t-set=\"activity_obj\" t-value=\"object.env[activity.res_model].browse(activity.res_id)\"/>\n"
"                                <p style=\"margin-bottom:0 !important;\">Deadline:\n"
"                                <span t-field=\"activity.date_deadline\" t-options=\"{'widget': 'date'}\"/>\n"
"                            </p>\n"
"                                <p style=\"margin:0 !important;\">\n"
"                                <span t-out=\"activity_obj.display_name\"/>\n"
"                                        -\n"
"                                <span t-out=\"activity.summary or activity_obj.activity_type_id.display_name\"/>\n"
"                            </p>\n"
"                            </li>\n"
"                        </t>\n"
"                    </ul>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""

