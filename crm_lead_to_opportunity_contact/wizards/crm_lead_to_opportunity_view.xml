<odoo>
    <record id="view_crm_lead2opportunity_partner" model="ir.ui.view">
        <field name="model">crm.lead2opportunity.partner</field>
        <field name="inherit_id" ref="crm.view_crm_lead2opportunity_partner" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='partner_id']/ancestor::div[hasclass('row')][1]"
                position="inside"
            >
                <t invisible="action != 'create_child'">
                    <label for="create_child_partner_id" class="col-3 p-0" />
                    <field
                        name="create_child_partner_id"
                        class="col p-0"
                        widget="res_partner_many2one"
                        context="{'res_partner_search_mode': 'customer', 'show_vat': True}"
                        required="action == 'create_child'"
                    />
                </t>
            </xpath>
        </field>
    </record>
</odoo>
