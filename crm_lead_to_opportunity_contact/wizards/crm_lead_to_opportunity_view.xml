<odoo>
    <record id="view_crm_lead2opportunity_partner" model="ir.ui.view">
        <field name="model">crm.lead2opportunity.partner</field>
        <field name="inherit_id" ref="crm.view_crm_lead2opportunity_partner" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='action']" position="after">
                <field name="partner_is_company" invisible="1" />
                <div
                    name="contact_action"
                    invisible="name != 'convert' or action != 'exist' or not partner_is_company or not lead_contact_name"
                    class="row"
                >
                    <div class="col-3 offset-1">
                        <field name="contact_action" nolabel="1" widget="radio" />
                    </div>
                    <div class="col-4">
                        <div class="row" style="height: 33.33%;">
                            <t invisible="contact_action != 'create_contact'">
                                <label
                                    for="lead_contact_name"
                                    class="col-3 p-0"
                                    string="Contact"
                                />
                                <field
                                    name="lead_contact_name"
                                    class="col p-0"
                                    readonly="1"
                                />
                            </t>
                        </div>
                        <div class="row" style="height: 33.33%;">
                            <t invisible="contact_action != 'link_contact'">
                                <label for="contact_partner_id" class="col-3 p-0" />
                                <!-- `required` must never be true while the block
                                     is hidden: Odoo only skips the validation of
                                     fields carrying their own `invisible`. -->
                                <field
                                    name="contact_partner_id"
                                    class="col p-0"
                                    domain="[('parent_id', '=', partner_id), ('is_company', '=', False)]"
                                    required="name == 'convert' and contact_action == 'link_contact'"
                                />
                            </t>
                        </div>
                        <div class="row" style="height: 33.33%;" />
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
