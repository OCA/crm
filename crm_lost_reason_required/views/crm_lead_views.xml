<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Make lost_reason field required in the lost reason wizard -->
    <record id="view_crm_lead_lost_wizard_required" model="ir.ui.view">
        <field name="name">crm.lead.lost.wizard.required</field>
        <field name="model">crm.lead.lost</field>
        <field name="inherit_id" ref="crm.crm_lead_lost_view_form" />
        <field name="arch" type="xml">
            <!-- Make lost_reason field required in the wizard -->
            <xpath expr="//field[@name='lost_reason_id']" position="attributes">
                <attribute name="required">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>
