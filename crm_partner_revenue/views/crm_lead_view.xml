<odoo>
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">Add partner revenue field</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <group name="lead_priority" position="before">
                <group>
                    <field name="partner_revenue_range_id" invisible="not partner_id" />
                </group>
            </group>
        </field>
    </record>

    <record model="ir.ui.view" id="crm_case_tree_view_leads">
        <field name="name">Add revenue range field as tree column</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_revenue_range_id" optional="hide" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="crm_case_tree_view_oppor">
        <field name="name">Add revenue range field as tree column</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_revenue_range_id" optional="hide" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="view_crm_case_opportunities_filter">
        <field name="name">Add revenue range filter</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter
                    string="Revenue Range"
                    name="revenue_range"
                    context="{'group_by': 'partner_revenue_range_id'}"
                />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_crm_case_leads_filter">
        <field name="name">Add revenue range filter</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter
                    string="Revenue Range"
                    name="revenue_range"
                    context="{'group_by': 'partner_revenue_range_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
