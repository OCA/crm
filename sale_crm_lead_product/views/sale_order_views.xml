<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_form" model="ir.ui.view">
        <field name="name">sale_mrp_bom.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <field name="show_copy_products_from_opportunity" invisible="1" />
                <button
                    name="copy_products_from_opportunity"
                    type="object"
                    string="Copy Products from Opportunity"
                    class="oe_highlight"
                    invisible="not show_copy_products_from_opportunity"
                />
            </header>
        </field>
    </record>
</odoo>
