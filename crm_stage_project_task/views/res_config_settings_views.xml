<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_form_view" model="ir.ui.view">
        <field name="name">res.config.settings.form.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="crm_lead" position="after">
                <setting
                    id="crm_state_project_task"
                    company_dependent="1"
                    help="Set the default project for tasks created from CRM when switching between statuses"
                >
                    <field name="company_stage_project_id" />
                </setting>
            </setting>
        </field>
    </record>

</odoo>
