<odoo>

    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form (in crm_lead_mobile)</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <field name="lost_reason_id" position="before">
                <field name="mobile" widget="phone" />
            </field>
        </field>
    </record>

    <record id="quick_create_opportunity_form" model="ir.ui.view">
        <field name="name">crm.lead.form.quick_create (in crm_lead_mobile)</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form" />
        <field name="arch" type="xml">
            <field name="phone" position="after">
                <field name="mobile" widget="phone" />
            </field>
        </field>
    </record>

</odoo>
